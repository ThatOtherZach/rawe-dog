modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "e2e-digest"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd tests && node_modules/.bin/playwright test specs/digest-cohesion.spec.ts --reporter=list"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
RAWEDOG_CRYPTO_NETWORK = "base"
RAWEDOG_CRYPTO_CONFIRMATIONS = "5"
RAWEDOG_SEARCH_CREDIT_PRICE_USD = "1"
RAWEDOG_QUOTE_TTL_HOURS = "24"
RAWEDOG_CRYPTO_RECEIVING_ADDRESS = "0x00000000000000000000000000000000"
RAWEDOG_CREDITS_ENFORCED = "true"

[userenv.development]
THEIRSTACK_BASE_URL = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJ2ZXIiOjEsImp0aSI6IjJkMjI4YmIwLTcyM2YtNDYxNC04NDFmLWFjZDFlMzliZDQ4ZCIsImNyZWF0ZWRfYnkiOjE4ODYzMCwicGVybWlzc2lvbnMiOltdLCJhdWQiOiJhcGkiLCJpYXQiOjE3ODQ5MTA0NTEsInN1YiI6IjE4Nzc5NSIsIm5hbWUiOiJSZXN1bWUgQnVpbGRlciIsImVtYWlsIjoidGhlemFjam9yZGFuQGdtYWlsLmNvbSJ9.1Cb354JCA2qkHHoFmhGHD5HmRfW2Iv11MdHKyzMrIkY"
RAWEDOG_CREDITS_ENFORCED = "flase"
