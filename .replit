modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "e2e-digest"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd tests && node_modules/.bin/playwright test specs/digest-cohesion.spec.ts --reporter=list"

[workflows.workflow.metadata]
isValidation = true

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[userenv]

[userenv.production]
RAWEDOG_CRYPTO_NETWORK = "base"
RAWEDOG_CRYPTO_CONFIRMATIONS = "5"
RAWEDOG_SEARCH_CREDIT_PRICE_USD = "1"
RAWEDOG_QUOTE_TTL_HOURS = "24"
RAWEDOG_CRYPTO_RECEIVING_ADDRESS = "0x00000000000000000000000000000000"
RAWEDOG_CREDITS_ENFORCED = "true"
FREE_TIER_ENABLED = "false"

[userenv.development]
RAWEDOG_CREDITS_ENFORCED = "flase"
